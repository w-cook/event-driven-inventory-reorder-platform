# Aspire HostAddress
# @InventoryReorderPlatform.Api_HostAddress = https://localhost:7025

# Docker HostAddress
@InventoryReorderPlatform.Api_HostAddress = http://localhost:8080

###
# Expected ItemIds
@firstItemId = 1
@secondItemId = 2

###
# Get all inventory items
GET {{InventoryReorderPlatform.Api_HostAddress}}/api/inventoryitems
Accept: application/json

###
# Get the active item by id
GET {{InventoryReorderPlatform.Api_HostAddress}}/api/inventoryitems/{{firstItemId}}
Accept: application/json

###
# Get all reorder events
GET {{InventoryReorderPlatform.Api_HostAddress}}/api/reorderevents
Accept: application/json

###
# Get operations health
GET {{InventoryReorderPlatform.Api_HostAddress}}/api/operations/health
Accept: application/json

###
# Create item ABOVE threshold -> should become Active, no reorder event needed
POST {{InventoryReorderPlatform.Api_HostAddress}}/api/inventoryitems
Content-Type: application/json

{
  "name": "Mechanical Keyboard",
  "sku": "KEY-1001",
  "quantityOnHand": 20,
  "reorderThreshold": 5
}

###
# Update the first item so it crosses into ReorderPending, creating reorder event
PUT {{InventoryReorderPlatform.Api_HostAddress}}/api/inventoryitems/{{firstItemId}}
Content-Type: application/json

{
  "name": "Mechanical Keyboard",
  "sku": "KEY-1001",
  "quantityOnHand": 4,
  "reorderThreshold": 5
}

###
# Update the first item lower, without creating duplicate reorder event
PUT {{InventoryReorderPlatform.Api_HostAddress}}/api/inventoryitems/{{firstItemId}}
Content-Type: application/json

{
  "name": "Mechanical Keyboard",
  "sku": "KEY-1001",
  "quantityOnHand": 2,
  "reorderThreshold": 5
}

###
# Recover the first item above threshold -> should go back to Active
PUT {{InventoryReorderPlatform.Api_HostAddress}}/api/inventoryitems/{{firstItemId}}
Content-Type: application/json

{
  "name": "Mechanical Keyboard",
  "sku": "KEY-1001",
  "quantityOnHand": 12,
  "reorderThreshold": 5
}

###
# Create item BELOW threshold -> should become ReorderPending, creating reorder event
POST {{InventoryReorderPlatform.Api_HostAddress}}/api/inventoryitems
Content-Type: application/json

{
  "name": "USB-C Docking Station",
  "sku": "DOCK-2001",
  "quantityOnHand": 3,
  "reorderThreshold": 5
}