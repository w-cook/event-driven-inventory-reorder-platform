{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "SupplierBehavior": {
        "Mode": "Normal",
        "DelayMilliseconds": 1500,
        "TransientFailuresBeforeSuccess": 2,
        "PermanentRejectionMessage": "The supplier rejected the requested order."
    }
}
